# Copy to .env (never commit .env). Example values only.
FLASK_APP=wsgi
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_PATH=instance/astra_vital.db
SEED_DEMO=1
# 1 = seed and show the three PUBLIC demo accounts on /login (app/demo.py); 0 = hide/disable them
DEMO_ACCOUNTS=1
ADMIN_EMAIL=admin@nyxara.example
ADMIN_PASSWORD=choose-a-strong-password
